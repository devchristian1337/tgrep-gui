<Window x:Class="TgrepGui.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:controls="using:TgrepGui.Controls" xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
 Title="tgrep-gui">
  <Grid x:Name="Root">
    <Grid.Resources><controls:BooleanVisibilityConverter x:Key="BoolVisibility" /></Grid.Resources>
    <Grid.KeyboardAccelerators>
      <KeyboardAccelerator Key="L" Modifiers="Control" Invoked="FocusQuery_Invoked" />
      <KeyboardAccelerator Key="Escape" Invoked="Cancel_Invoked" />
      <KeyboardAccelerator Key="F3" Invoked="OpenLine_Invoked" />
    </Grid.KeyboardAccelerators>
    <NavigationView x:Name="Navigation" PaneDisplayMode="LeftCompact" IsBackButtonVisible="Collapsed"
      IsPaneToggleButtonVisible="False" IsSettingsVisible="True" SelectionChanged="Navigation_SelectionChanged">
      <NavigationView.MenuItems><NavigationViewItem x:Name="SearchNav" Content="Ricerca" Icon="Find" Tag="search" /></NavigationView.MenuItems>
      <Grid>
        <Grid x:Name="SearchPage" Padding="24,12,24,12" RowSpacing="12">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel Spacing="3">
              <TextBlock Text="tgrep" FontSize="30" FontWeight="SemiBold" />
              <TextBlock Text="Il tuo codice, a portata di ricerca." Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
            <CommandBar Grid.Column="1" Background="Transparent" DefaultLabelPosition="Right" VerticalAlignment="Center" IsOpen="False">
              <AppBarButton Icon="Refresh" Label="Riavvia server" Command="{Binding RestartCommand}" ToolTipService.ToolTip="Riavvia solo il server avviato da questa app" />
              <AppBarButton Icon="List" Label="Log">
                <AppBarButton.Flyout>
                  <Flyout Placement="BottomEdgeAlignedRight" Opening="LogFlyout_Opening">
                    <Flyout.FlyoutPresenterStyle>
                      <Style TargetType="FlyoutPresenter">
                        <Setter Property="MaxWidth" Value="680" />
                        <Setter Property="MaxHeight" Value="480" />
                        <Setter Property="Padding" Value="16" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="ScrollViewer.HorizontalScrollMode" Value="Disabled" />
                        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
                        <Setter Property="ScrollViewer.VerticalScrollMode" Value="Disabled" />
                        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
                      </Style>
                    </Flyout.FlyoutPresenterStyle>
                    <Grid x:Name="LogPanel" Width="620" Height="360" RowSpacing="12">
                      <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                      <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Button x:Name="CopyLogButton" Content="Copia log" MinWidth="96" Click="CopyLog_Click" />
                        <TextBlock Grid.Column="1" Text="LOG TGREP · ultime 1.000 righe" Style="{StaticResource SectionLabel}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                      </Grid>
                      <ListView Grid.Row="1" ItemsSource="{Binding Logs}" SelectionMode="None"
                        ScrollViewer.HorizontalScrollMode="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                        ScrollViewer.VerticalScrollMode="Enabled" ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListView.ItemContainerStyle>
                          <Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch" /></Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="12" IsTextSelectionEnabled="True" TextWrapping="Wrap" /></DataTemplate></ListView.ItemTemplate>
                      </ListView>
                    </Grid>
                  </Flyout>
                </AppBarButton.Flyout>
              </AppBarButton>
            </CommandBar>
          </Grid>
          <StackPanel Grid.Row="1" Spacing="8">
            <InfoBar IsOpen="{Binding MissingTgrep, Mode=TwoWay}" Severity="Warning" Title="Installa tgrep" Message="{x:Bind DownloadHint}">
              <InfoBar.ActionButton><HyperlinkButton Content="Scarica tgrep" NavigateUri="https://github.com/microsoft/tgrep/releases" /></InfoBar.ActionButton>
            </InfoBar>
            <InfoBar IsOpen="{Binding HasWarning}" Severity="Warning" Title="Avviso" Message="{Binding Warning}" IsClosable="True" />
          </StackPanel>
          <Border Grid.Row="2" Style="{StaticResource Card}" Padding="16">
            <Grid RowSpacing="12">
              <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
              <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <AutoSuggestBox x:Name="FolderBox" Header="Cartella" PlaceholderText="Scegli una cartella di progetto" IsEnabled="{Binding CanEdit}"
                  Text="{Binding Folder, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ItemsSource="{Binding RecentFolders}" SuggestionChosen="Folder_SuggestionChosen" QueryIcon="Folder" />
                <Button Grid.Column="1" Content="Sfoglia…" VerticalAlignment="Bottom" Click="BrowseFolder_Click" IsEnabled="{Binding CanEdit}" />
              </Grid>
              <Grid Grid.Row="1" ColumnSpacing="12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <TextBox Header="Includi file" PlaceholderText="*.cs; *.xaml" IsEnabled="{Binding CanEdit}" Text="{Binding Include, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ToolTipService.ToolTip="Globs separati da spazio, virgola o punto e virgola. Usa virgolette per spazi nel nome." />
                <TextBox Grid.Column="1" Header="Escludi file o cartelle" IsEnabled="{Binding CanEdit}" PlaceholderText="bin/; obj/; *.min.js" Text="{Binding Exclude, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
              </Grid>
            </Grid>
          </Border>
          <Grid Grid.Row="3" RowSpacing="8">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Grid ColumnSpacing="8">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <TextBox x:Name="QueryBox" PlaceholderText="Cerca testo o un’espressione regolare…" FontSize="16" MinHeight="42"
                Text="{Binding Query, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" KeyDown="Query_KeyDown" AutomationProperties.Name="Testo da cercare" />
              <Button Grid.Column="1" Content="Cerca" Style="{StaticResource AccentButtonStyle}" Command="{Binding SearchCommand}" MinWidth="90" />
              <Button Grid.Column="2" Content="Annulla" Command="{Binding CancelCommand}" />
            </Grid>
            <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="16">
              <CheckBox Content="Ignora maiuscole" IsEnabled="{Binding CanEdit}" IsChecked="{Binding IgnoreCase, Mode=TwoWay}" />
              <CheckBox Content="Testo letterale" IsEnabled="{Binding CanEdit}" IsChecked="{Binding Literal, Mode=TwoWay}" />
              <CheckBox Content="Parola intera" IsEnabled="{Binding CanEdit}" IsChecked="{Binding WholeWord, Mode=TwoWay}" />
              <CheckBox Content="Usa indice" IsEnabled="{Binding CanEdit}" IsChecked="{Binding UseIndex, Mode=TwoWay}" />
            </StackPanel>
          </Grid>
          <Grid Grid.Row="4" MinHeight="100">
            <Grid.ColumnDefinitions><ColumnDefinition Width="300" MinWidth="180" /><ColumnDefinition Width="8" /><ColumnDefinition Width="*" MinWidth="240" /></Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}">
              <Grid RowSpacing="4">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <TextBlock Text="FILE CON CORRISPONDENZE" Margin="16,14,16,10" Style="{StaticResource SectionLabel}" />
                <ListView x:Name="FileList" Grid.Row="1" ItemsSource="{Binding Files}" SelectedItem="{Binding SelectedFile, Mode=TwoWay}" SelectionMode="Single">
                  <ListView.ItemTemplate>
                    <DataTemplate>
                      <Grid Padding="0,6" ColumnSpacing="8" HorizontalAlignment="Stretch">
                        <Grid.ContextFlyout>
                          <MenuFlyout>
                            <MenuFlyoutItem Text="Apri" Icon="OpenFile" Click="FileOpen_Click" Tag="{Binding FullPath}" />
                            <MenuFlyoutItem Text="Apri cartella contenente" Icon="Folder" Click="FileFolder_Click" Tag="{Binding FullPath}" />
                            <MenuFlyoutItem Text="Copia percorso" Icon="Copy" Click="FileCopy_Click" Tag="{Binding FullPath}" />
                          </MenuFlyout>
                        </Grid.ContextFlyout>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel Spacing="3">
                          <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                          <TextBlock Text="{Binding RelativePath}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding FullPath}" />
                        </StackPanel>
                        <Border Grid.Column="1" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="10" Padding="8,2" VerticalAlignment="Center"><TextBlock Text="{Binding Count}" FontSize="12" /></Border>
                      </Grid>
                    </DataTemplate>
                  </ListView.ItemTemplate>
                  <ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch" /></Style></ListView.ItemContainerStyle>
                </ListView>
              </Grid>
            </Border>
            <toolkit:GridSplitter Grid.Column="1" Width="8" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" HorizontalAlignment="Stretch" AutomationProperties.Name="Ridimensiona pannelli risultati" />
            <Border Grid.Column="2" Style="{StaticResource Card}">
              <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <TextBlock Text="{Binding SelectedPath}" Margin="16,14,16,10" FontSize="12" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding SelectedPath}" IsTextSelectionEnabled="True" />
                <ListView x:Name="MatchList" Grid.Row="1" ItemsSource="{Binding SelectedFile.Lines}" SelectionMode="Extended"
                  DoubleTapped="Match_DoubleTapped" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollMode="Enabled">
                  <ListView.KeyboardAccelerators><KeyboardAccelerator Key="C" Modifiers="Control" Invoked="CopyMatches_Invoked" /></ListView.KeyboardAccelerators>
                  <ListView.ContextFlyout><MenuFlyout><MenuFlyoutItem Text="Copia righe selezionate" Icon="Copy" Click="CopyMatches_Click" /><MenuFlyoutItem Text="Apri nell’editor · F3" Icon="OpenFile" Click="OpenSelected_Click" /></MenuFlyout></ListView.ContextFlyout>
                  <ListView.ItemTemplate>
                    <DataTemplate>
                      <Grid ColumnSpacing="16" Padding="0,4">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="60" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding LineNumber}" FontFamily="Consolas" FontSize="13" HorizontalAlignment="Right" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <controls:MatchText Grid.Column="1" Match="{Binding}" />
                      </Grid>
                    </DataTemplate>
                  </ListView.ItemTemplate>
                </ListView>
                <TextBlock Grid.Row="2" Text="F3 / doppio clic  Apri nell’editor     Ctrl+C  Copia selezione" Margin="16,8" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
              </Grid>
            </Border>
          </Grid>
          <StackPanel Grid.Row="5" Spacing="8">
            <ProgressBar IsIndeterminate="True" Visibility="{Binding IsBusy, Converter={StaticResource BoolVisibility}}" Height="2" />
            <TextBlock Text="{Binding Message}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding Message}" />
            <StackPanel Orientation="Horizontal" Spacing="20">
              <TextBlock Text="{Binding Server}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
              <TextBlock FontSize="12"><Run Text="Indicizzati: " /><Run Text="{Binding IndexedFiles}" /></TextBlock>
              <TextBlock FontSize="12"><Run Text="Corrispondenze: " /><Run Text="{Binding MatchCount}" /></TextBlock>
              <TextBlock Text="{Binding Elapsed}" FontSize="12" />
              <TextBlock FontSize="12"><Run Text="Avvisi: " /><Run Text="{Binding WarningCount}" /></TextBlock>
            </StackPanel>
          </StackPanel>
        </Grid>
        <Frame x:Name="SettingsFrame" Visibility="Collapsed" />
      </Grid>
    </NavigationView>
  </Grid>
</Window>
