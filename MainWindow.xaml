<Window x:Class="TgrepGui.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:controls="using:TgrepGui.Controls" xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
 xmlns:vm="using:TgrepGui.ViewModels"
 Title="tgrep-gui">
  <Grid x:Name="Root" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
    <Grid.Resources><controls:BooleanVisibilityConverter x:Key="BoolVisibility" /></Grid.Resources>
    <Grid.KeyboardAccelerators>
      <KeyboardAccelerator Key="L" Modifiers="Control" Invoked="FocusQuery_Invoked" />
      <KeyboardAccelerator Key="Escape" Invoked="Cancel_Invoked" />
      <KeyboardAccelerator Key="F3" Invoked="OpenLine_Invoked" />
    </Grid.KeyboardAccelerators>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <TitleBar x:Name="AppTitleBar" Title="tgrep-gui">
      <TitleBar.IconSource>
        <ImageIconSource ImageSource="ms-appx:///Assets/StoreLogo.png" />
      </TitleBar.IconSource>
    </TitleBar>
    <NavigationView x:Name="Navigation" Grid.Row="1" PaneDisplayMode="LeftCompact" IsBackButtonVisible="Collapsed"
      IsPaneToggleButtonVisible="False" IsSettingsVisible="True" SelectionChanged="Navigation_SelectionChanged">
      <NavigationView.MenuItems><NavigationViewItem x:Name="SearchNav" Content="Search" Icon="Find" Tag="search" /></NavigationView.MenuItems>
      <Grid x:Name="ScaleHost" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <Grid x:Name="SearchPage" Padding="24,12,24,12" RowSpacing="12" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock Text="Search" FontSize="{Binding SubtitleFontSize}" FontWeight="SemiBold" VerticalAlignment="Center" />
            <CommandBar Grid.Column="1" Background="Transparent" DefaultLabelPosition="Right" VerticalAlignment="Center" IsOpen="False">
              <AppBarButton Icon="Refresh" Label="Restart server" Command="{Binding RestartCommand}" ToolTipService.ToolTip="Restart only the server started by this app" />
              <AppBarButton Icon="List" Label="Log">
                <AppBarButton.Flyout>
                  <Flyout Placement="BottomEdgeAlignedRight" Opening="LogFlyout_Opening">
                    <Flyout.FlyoutPresenterStyle>
                      <Style TargetType="FlyoutPresenter">
                        <Setter Property="MaxWidth" Value="680" />
                        <Setter Property="MaxHeight" Value="480" />
                        <Setter Property="Padding" Value="16" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="ScrollViewer.HorizontalScrollMode" Value="Disabled" />
                        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
                        <Setter Property="ScrollViewer.VerticalScrollMode" Value="Disabled" />
                        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
                      </Style>
                    </Flyout.FlyoutPresenterStyle>
                    <Grid x:Name="LogPanel" Width="620" Height="360" RowSpacing="12">
                      <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                      <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Button x:Name="CopyLogButton" Content="Copy log" MinWidth="96" Click="CopyLog_Click" />
                        <TextBlock Grid.Column="1" Text="TGREP LOG · last 1,000 lines" Style="{StaticResource SectionLabel}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                      </Grid>
                      <ListView Grid.Row="1" ItemsSource="{Binding Logs}" SelectionMode="None" FontSize="{Binding BodyFontSize}" ContainerContentChanging="ResultList_ContainerContentChanging"
                        ScrollViewer.HorizontalScrollMode="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                        ScrollViewer.VerticalScrollMode="Enabled" ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListView.ItemContainerStyle>
                          <Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch" /></Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" FontFamily="Consolas" IsTextSelectionEnabled="True" TextWrapping="Wrap" /></DataTemplate></ListView.ItemTemplate>
                      </ListView>
                    </Grid>
                  </Flyout>
                </AppBarButton.Flyout>
              </AppBarButton>
            </CommandBar>
          </Grid>
          <StackPanel Grid.Row="1" Spacing="8">
            <InfoBar IsOpen="{Binding MissingTgrep, Mode=TwoWay}" Severity="Warning" Title="Install tgrep" Message="{x:Bind DownloadHint}">
              <InfoBar.ActionButton><HyperlinkButton Content="Download tgrep" NavigateUri="https://github.com/microsoft/tgrep/releases" /></InfoBar.ActionButton>
            </InfoBar>
            <InfoBar IsOpen="{Binding HasWarning}" Severity="Warning" Title="Warning" Message="{Binding Warning}" IsClosable="True" />
          </StackPanel>
          <Grid Grid.Row="2">
              <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <AutoSuggestBox x:Name="FolderBox" Header="Project folder" PlaceholderText="Choose a folder to search" IsEnabled="{Binding CanEdit}"
                  Text="{Binding Folder, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ItemsSource="{Binding RecentFolders}" SuggestionChosen="Folder_SuggestionChosen"
                  QuerySubmitted="Folder_QuerySubmitted" LostFocus="Folder_LostFocus" QueryIcon="Folder" />
                <Button Grid.Column="1" Content="Browse…" VerticalAlignment="Bottom" MinWidth="96" Click="BrowseFolder_Click" IsEnabled="{Binding CanEdit}" />
              </Grid>
          </Grid>
          <Grid Grid.Row="3" RowSpacing="8">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Grid>
              <TextBlock Text="Find in project" FontWeight="SemiBold" />
              <TextBlock Text="Ctrl+L to focus · Enter to search" HorizontalAlignment="Right" Style="{StaticResource SectionLabel}" />
            </Grid>
            <Grid Grid.Row="1" ColumnSpacing="8">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <TextBox x:Name="QueryBox" PlaceholderText="Text or regular expression" FontSize="{Binding QueryFontSize}" MinHeight="{Binding QueryMinHeight}" VerticalContentAlignment="Center"
                Text="{Binding Query, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" KeyDown="Query_KeyDown" AutomationProperties.Name="Search text" />
              <Button x:Name="SearchButton" Grid.Column="1" AutomationProperties.Name="Search" Style="{StaticResource AccentButtonStyle}" Command="{Binding SearchCommand}" MinWidth="112" Height="{Binding QueryMinHeight}">
                <StackPanel Orientation="Horizontal" Spacing="8"><SymbolIcon Symbol="Find" /><TextBlock Text="Search" /></StackPanel>
              </Button>
              <Button Grid.Column="2" Content="Cancel" Command="{Binding CancelCommand}" Height="{Binding QueryMinHeight}" Visibility="{Binding IsBusy, Converter={StaticResource BoolVisibility}}" />
            </Grid>
            <Grid Grid.Row="2" ColumnSpacing="16">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <StackPanel Orientation="Horizontal" Spacing="16">
              <CheckBox Content="Ignore case" IsEnabled="{Binding CanEdit}" IsChecked="{Binding IgnoreCase, Mode=TwoWay}" />
              <CheckBox Content="Literal text" IsEnabled="{Binding CanEdit}" IsChecked="{Binding Literal, Mode=TwoWay}" />
              <CheckBox Content="Whole word" IsEnabled="{Binding CanEdit}" IsChecked="{Binding WholeWord, Mode=TwoWay}" />
              <CheckBox Content="Use index" IsEnabled="{Binding CanEdit}" IsChecked="{Binding UseIndex, Mode=TwoWay}" />
              </StackPanel>
              <ToggleButton x:Name="FiltersToggle" Grid.Column="1" IsChecked="{Binding FiltersExpanded, Mode=TwoWay}"
                AutomationProperties.AutomationId="FiltersToggle" AutomationProperties.Name="Show file filters"
                ToolTipService.ToolTip="Include or exclude files from the search">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <FontIcon Glyph="&#xE71C;" FontSize="{Binding IconFontSize}" />
                  <TextBlock Text="Filters" />
                  <TextBlock Text="{Binding FilterSummary}" />
                </StackPanel>
              </ToggleButton>
            </Grid>
            <Grid Grid.Row="3" ColumnSpacing="12" Padding="0,4,0,4"
              Visibility="{Binding FiltersExpanded, Converter={StaticResource BoolVisibility}}">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
              <TextBox x:Name="IncludeBox" Header="Include files" PlaceholderText="*.cs; *.xaml" IsEnabled="{Binding CanEdit}"
                Text="{Binding Include, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                ToolTipService.ToolTip="Globs separated by space, comma, or semicolon. Quote names that contain spaces." />
              <TextBox x:Name="ExcludeBox" Grid.Column="1" Header="Exclude files or folders" PlaceholderText="bin/; obj/; *.min.js"
                IsEnabled="{Binding CanEdit}" Text="{Binding Exclude, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            </Grid>
          </Grid>
          <Grid Grid.Row="4" MinHeight="160">
            <Grid.ColumnDefinitions><ColumnDefinition Width="300" MinWidth="180" /><ColumnDefinition Width="8" /><ColumnDefinition Width="*" MinWidth="240" /></Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}">
              <Grid RowSpacing="4" Padding="0,0,0,12">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                <Border Padding="16,12" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                  <Grid>
                    <TextBlock Text="Files" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding FileCount}" HorizontalAlignment="Right" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                  </Grid>
                </Border>
                <StackPanel Grid.Row="1" Margin="16,12" Spacing="6" VerticalAlignment="Center" Visibility="{Binding NoFiles, Converter={StaticResource BoolVisibility}}" IsHitTestVisible="False">
                  <SymbolIcon Symbol="Find" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                  <TextBlock Text="Files appear here" FontWeight="SemiBold" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" />
                  <TextBlock Text="Run a search to fill this list." TextWrapping="Wrap" TextAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <ListView x:Name="FileList" Grid.Row="1" ItemsSource="{Binding Files}" SelectedItem="{Binding SelectedFile, Mode=TwoWay}" SelectionMode="Single" FontSize="{Binding PathFontSize}" ContainerContentChanging="ResultList_ContainerContentChanging">
                  <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:FileResult">
                      <Grid Padding="0,6" ColumnSpacing="8" HorizontalAlignment="Stretch">
                        <Grid.ContextFlyout>
                          <MenuFlyout>
                            <MenuFlyoutItem Text="Open" Icon="OpenFile" Click="FileOpen_Click" Tag="{Binding FullPath}" />
                            <MenuFlyoutItem Text="Open containing folder" Icon="Folder" Click="FileFolder_Click" Tag="{Binding FullPath}" />
                            <MenuFlyoutItem Text="Copy path" Icon="Copy" Click="FileCopy_Click" Tag="{Binding FullPath}" />
                          </MenuFlyout>
                        </Grid.ContextFlyout>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel Spacing="3">
                          <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                          <TextBlock Text="{x:Bind DirectoryLabel}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind FullPath}" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{x:Bind Count, Mode=OneWay}" Margin="8,0,4,0" VerticalAlignment="Center"
                          Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                      </Grid>
                    </DataTemplate>
                  </ListView.ItemTemplate>
                  <ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch" /></Style></ListView.ItemContainerStyle>
                </ListView>
              </Grid>
            </Border>
            <toolkit:GridSplitter Grid.Column="1" Width="8" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" HorizontalAlignment="Stretch" AutomationProperties.Name="Resize result panes" />
            <Border Grid.Column="2" Style="{StaticResource Card}">
              <Grid Padding="0,0,0,8">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <Border Padding="16,8" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                  <Grid ColumnSpacing="12" MinHeight="32">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding SelectedPath}" FontSize="{Binding PathFontSize}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding SelectedPath}" IsTextSelectionEnabled="True" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4"
                      Visibility="{Binding NoSelection, Converter={StaticResource BoolVisibility}, ConverterParameter=Invert}">
                      <Button x:Name="CopyPathButton" Click="CopySelectedPath_Click" Background="Transparent" BorderThickness="0"
                        AutomationProperties.Name="Copy file path" ToolTipService.ToolTip="Copy file path">
                        <FontIcon Glyph="&#xE8C8;" FontSize="{Binding IconFontSize}" />
                      </Button>
                      <Button x:Name="OpenPreviewButton" Click="OpenSelected_Click" Background="Transparent" BorderThickness="0"
                        AutomationProperties.Name="Open in editor" ToolTipService.ToolTip="Open in editor (F3)">
                        <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE8A7;" FontSize="{Binding IconFontSize}" /><TextBlock Text="Open" /></StackPanel>
                      </Button>
                    </StackPanel>
                  </Grid>
                </Border>
                <StackPanel Grid.Row="1" Margin="16,12" Spacing="6" VerticalAlignment="Center" HorizontalAlignment="Stretch"
                  Visibility="{Binding NoSelection, Converter={StaticResource BoolVisibility}}" IsHitTestVisible="False">
                  <FontIcon Glyph="&#xE943;" FontSize="{Binding EmptyIconFontSize}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                  <TextBlock Text="Your code, in context" FontSize="{Binding SubtitleFontSize}" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap" />
                  <TextBlock Text="Search the project, then select a file to view matches." TextAlignment="Center" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <ListView x:Name="MatchList" Grid.Row="1" ItemsSource="{Binding SelectedFile.Lines}" SelectionMode="Extended" FontSize="{Binding CodeFontSize}" ContainerContentChanging="ResultList_ContainerContentChanging"
                  DoubleTapped="Match_DoubleTapped" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollMode="Enabled">
                  <ListView.KeyboardAccelerators><KeyboardAccelerator Key="C" Modifiers="Control" Invoked="CopyMatches_Invoked" /></ListView.KeyboardAccelerators>
                  <ListView.ContextFlyout><MenuFlyout><MenuFlyoutItem Text="Copy selected lines" Icon="Copy" Click="CopyMatches_Click" /><MenuFlyoutItem Text="Open in editor · F3" Icon="OpenFile" Click="OpenSelected_Click" /></MenuFlyout></ListView.ContextFlyout>
                  <ListView.ItemTemplate>
                    <DataTemplate>
                      <Grid ColumnSpacing="16" Padding="0,4">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="60" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding LineNumber}" FontFamily="Consolas" HorizontalAlignment="Right" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <controls:MatchText Grid.Column="1" Match="{Binding}" />
                      </Grid>
                    </DataTemplate>
                  </ListView.ItemTemplate>
                </ListView>
                <TextBlock Grid.Row="2" Margin="16,8" FontSize="{Binding CaptionFontSize}" TextWrapping="Wrap"
                  Visibility="{Binding NoSelection, Converter={StaticResource BoolVisibility}, ConverterParameter=Invert}"
                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                  Text="F3 / double-click · Open in editor    Ctrl+C · Copy selection" />
              </Grid>
            </Border>
          </Grid>
          <StackPanel Grid.Row="5" Spacing="8">
            <ProgressBar IsIndeterminate="True" Visibility="{Binding IsBusy, Converter={StaticResource BoolVisibility}}" Height="2" />
            <TextBlock Text="{Binding Message}" AutomationProperties.LiveSetting="Polite" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding Message}" />
            <StackPanel Orientation="Horizontal" Spacing="20">
              <TextBlock Text="{Binding Server}" FontSize="{Binding BodyFontSize}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
              <TextBlock FontSize="{Binding BodyFontSize}"><Run Text="Indexed: " /><Run Text="{Binding IndexedFiles}" /></TextBlock>
              <TextBlock FontSize="{Binding BodyFontSize}"><Run Text="Matches: " /><Run Text="{Binding MatchCount}" /></TextBlock>
              <TextBlock Text="{Binding Elapsed}" FontSize="{Binding BodyFontSize}" />
              <TextBlock FontSize="{Binding BodyFontSize}"><Run Text="Warnings: " /><Run Text="{Binding WarningCount}" /></TextBlock>
            </StackPanel>
          </StackPanel>
        </Grid>
        <Frame x:Name="SettingsFrame" Visibility="Collapsed" />
      </Grid>
    </NavigationView>
  </Grid>
</Window>
