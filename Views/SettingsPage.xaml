<Page x:Class="TgrepGui.Views.SettingsPage"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:controls="using:TgrepGui.Controls">
  <Page.Resources>
    <controls:BooleanVisibilityConverter x:Key="BoolVisibility" />
  </Page.Resources>
  <ScrollViewer HorizontalContentAlignment="Stretch" HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled">
    <StackPanel Margin="24,24" Spacing="20">
      <TextBlock Text="Settings" FontSize="28" FontWeight="SemiBold" />
      <TextBlock Text="Configure the search engine and your editor." Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
      <InfoBar x:Name="SaveInfo" IsOpen="False" />
      <Border Style="{StaticResource Card}" Padding="20">
        <StackPanel Spacing="16">
          <TextBlock Text="SEARCH ENGINE" Style="{StaticResource SectionLabel}" />
          <TextBlock Text="Installed version" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
          <TextBlock Text="{Binding EngineVersion}" FontSize="18" FontWeight="SemiBold" IsTextSelectionEnabled="True" TextWrapping="Wrap" AutomationProperties.Name="Installed tgrep version" />
          <StackPanel Orientation="Horizontal" Spacing="12">
            <Button Content="Update tgrep" Command="{Binding UpdateEngineCommand}" ToolTipService.ToolTip="Check GitHub for a newer official tgrep and install it for the next launch" />
            <ProgressRing IsActive="{Binding IsEngineUpdating}" Width="20" Height="20"
              Visibility="{Binding IsEngineUpdating, Converter={StaticResource BoolVisibility}}" />
          </StackPanel>
          <TextBlock Text="{Binding EngineUpdateStatus}" TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" AutomationProperties.LiveSetting="Polite" />
          <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBox x:Name="TgrepPathBox" Header="tgrep.exe path" PlaceholderText="Automatic: verified update, bundled engine, then PATH" />
            <Button Grid.Column="1" Content="Browse…" VerticalAlignment="Bottom" Click="BrowseTgrep_Click" />
          </Grid>
          <CheckBox x:Name="AutoUpdateEngineBox" Content="Automatically update tgrep" />
          <TextBlock Text="Verified updates apply after restarting the app. Update tgrep also works when automatic checks are off. A manual engine path disables managed updates." TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
          <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBox x:Name="IndexPathBox" Header="Custom index path" PlaceholderText="Empty = .tgrep in the searched folder" />
            <Button Grid.Column="1" Content="Browse…" VerticalAlignment="Bottom" Click="BrowseIndex_Click" />
          </Grid>
          <TextBlock Text="Use a dedicated index directory for each project. A custom path is applied to every tgrep command." TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>
      </Border>
      <Border Style="{StaticResource Card}" Padding="20">
        <StackPanel Spacing="16">
          <TextBlock Text="EDITOR" Style="{StaticResource SectionLabel}" />
          <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBox x:Name="EditorPathBox" Header="Editor executable" PlaceholderText="Empty = Windows default application" />
            <Button Grid.Column="1" Content="Browse…" VerticalAlignment="Bottom" Click="BrowseEditor_Click" />
          </Grid>
          <TextBox x:Name="EditorArgsBox" Header="Arguments · $FILE and $LINE" FontFamily="Consolas" />
          <TextBlock Text="Visual Studio Code: --goto &quot;$FILE:$LINE&quot;   ·   Notepad++: -n$LINE &quot;$FILE&quot;" FontSize="12" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
          <TextBlock Text="To open at the exact line, configure an editor that supports $LINE. The default application opens the file only." FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>
      </Border>
      <Border Style="{StaticResource Card}" Padding="20">
        <StackPanel Spacing="12">
          <TextBlock Text="PREFERENCES" Style="{StaticResource SectionLabel}" />
          <ComboBox x:Name="ThemeBox" Header="Theme" HorizontalAlignment="Stretch">
            <ComboBoxItem Content="System" Tag="System" /><ComboBoxItem Content="Light" Tag="Light" /><ComboBoxItem Content="Dark" Tag="Dark" />
          </ComboBox>
          <CheckBox x:Name="IgnoreCaseBox" Content="Ignore case by default" />
          <CheckBox x:Name="LiteralBox" Content="Literal text by default" />
        </StackPanel>
      </Border>
      <Button x:Name="SaveButton" Content="Save settings" Style="{StaticResource AccentButtonStyle}" Click="Save_Click" />
      <TextBlock x:Name="SettingsLocation" FontSize="12" TextWrapping="Wrap" IsTextSelectionEnabled="True" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
    </StackPanel>
  </ScrollViewer>
</Page>
